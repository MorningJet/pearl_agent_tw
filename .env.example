# Shopify Storefront（目錄／變體對照；結帳已改走藍新）
VITE_SHOPIFY_STORE_DOMAIN=1gfsew-ic.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=
VITE_SHOPIFY_API_VERSION=2025-01
VITE_SHOPIFY_DESIGN_FEE_UNIT_VARIANT_GID=

# 藍新 MPG：H5 只連 Worker（HashKey/HashIV 绝不放這裡）
# 本機：先 npm run newebpay:dev，再用下方 proxy 路徑
VITE_NEWEBPAY_API_BASE=/newebpay-api
# 正式：填 Workers 網址，例如 https://pearl-newebpay.xxx.workers.dev
# VITE_NEWEBPAY_API_BASE=https://pearl-newebpay.YOUR_SUBDOMAIN.workers.dev
