{% comment %}
  Pearl Pearl DIY — inject at the TOP of layout/theme.liquid (Plan B).

  Use this when index.json still wins / homepage source still shows Horizon
  (Inter fonts, Theme.translations, min-height:85vh).

  Install:
  1. Themes → … → Edit code → layout/theme.liquid
  2. Scroll to the VERY TOP of the file (before <!doctype or <html>)
  3. Paste EVERYTHING in this file FIRST
  4. Scroll to the VERY BOTTOM of theme.liquid
  5. Add a single line: {% endif %}
  6. Save
  7. Phone source must be short: search "85vh" → none; search "pearl-diy-frame" → yes
    and there should be almost no Inter / Theme.translations chrome.
{% endcomment %}
{% if request.page_type == 'index' %}
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8">
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover"
    >
    <meta name="theme-color" content="#ffffff">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    <style>
      html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #fff;
      }
      #pearl-diy-frame {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 0;
        background: #fff;
      }
    </style>
  </head>
  <body>
    <iframe
      id="pearl-diy-frame"
      src="https://morningjet.github.io/pearl_agent_tw/?embed=1&v={{ 'now' | date: '%s' }}"
      title="Pearl Pearl DIY"
      allow="payment *; clipboard-write *"
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
    <script>
      (function () {
        function fit() {
          var vv = window.visualViewport
          var h = Math.round((vv && vv.height) || window.innerHeight || document.documentElement.clientHeight)
          var w = Math.round((vv && vv.width) || window.innerWidth || document.documentElement.clientWidth)
          var el = document.getElementById('pearl-diy-frame')
          if (!el) return
          el.style.width = w + 'px'
          el.style.height = h + 'px'
          if (vv) {
            el.style.top = (vv.offsetTop || 0) + 'px'
            el.style.left = (vv.offsetLeft || 0) + 'px'
          }
        }
        function onPearlDiyFit(e) {
          if (!e.data || e.data.type !== 'pearl-diy-fit') return
          var el = document.getElementById('pearl-diy-frame')
          if (!el || !e.data.height) return
          el.style.width = (e.data.width || window.innerWidth) + 'px'
          el.style.height = e.data.height + 'px'
        }
        fit()
        window.addEventListener('resize', fit)
        window.addEventListener('orientationchange', function () {
          setTimeout(fit, 50)
          setTimeout(fit, 300)
        })
        window.addEventListener('message', onPearlDiyFit)
        if (window.visualViewport) {
          window.visualViewport.addEventListener('resize', fit)
          window.visualViewport.addEventListener('scroll', fit)
        }
        setTimeout(fit, 50)
        setTimeout(fit, 300)
      })()
    </script>
  </body>
</html>
{% else %}
